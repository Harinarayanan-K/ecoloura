# Vercel server-side environment variable. NEVER use a VITE_ prefix.
GROQ_API_KEY=your_groq_api_key
# Optional: choose a model available to your Groq Free plan.
GROQ_MODEL=qwen/qwen3.8-27b

# Public build-time configuration for Vite (not NEXT_PUBLIC_*).
# Existing published business WhatsApp; override only with the actual business number.
VITE_WHATSAPP_NUMBER=918939540771
# Enable only after configuring the server variables below AND testing inbox delivery.
VITE_ENQUIRY_FORM_ENABLED=false
# Optional, actual account IDs only. Leave blank until supplied.
# Use GTM OR GA4; when both are supplied, GTM takes precedence.
VITE_GA4_ID=
VITE_GTM_ID=

# Server-only Resend credentials. Never add VITE_ to these.
RESEND_API_KEY=
# A sender on a domain you have verified in Resend. Required; no invented sender.
ENQUIRY_FROM_EMAIL=
# Owner-supplied destination inbox; verify it receives test messages before enabling.
ENQUIRY_TO_EMAIL=
